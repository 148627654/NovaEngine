# NovaEngine 测试资源：单位立方体（1×1×1，中心在原点）
# 24 个独立顶点保证每个面法线正确；每面为四边形（导入时由 Assimp 三角化）
# 格式：v 位置 / vn 法线 / vt UV；f 索引为 顶点/UV/法线
# 面序（从外部观察均为逆时针，右手系）：+Z 前 / -Z 后 / +X 右 / -X 左 / +Y 顶 / -Y 底

# ---- 顶点（每面 4 个，共 24 个）----
# 前 (+Z)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
# 后 (-Z)
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5
# 右 (+X)
v  0.5 -0.5  0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v  0.5  0.5  0.5
# 左 (-X)
v -0.5 -0.5 -0.5
v -0.5 -0.5  0.5
v -0.5  0.5  0.5
v -0.5  0.5 -0.5
# 顶 (+Y)
v -0.5  0.5  0.5
v  0.5  0.5  0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
# 底 (-Y)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5 -0.5  0.5
v -0.5 -0.5  0.5

# ---- 法线（每面 4 个，共 24 个）----
vn 0 0 1
vn 0 0 1
vn 0 0 1
vn 0 0 1
vn 0 0 -1
vn 0 0 -1
vn 0 0 -1
vn 0 0 -1
vn 1 0 0
vn 1 0 0
vn 1 0 0
vn 1 0 0
vn -1 0 0
vn -1 0 0
vn -1 0 0
vn -1 0 0
vn 0 1 0
vn 0 1 0
vn 0 1 0
vn 0 1 0
vn 0 -1 0
vn 0 -1 0
vn 0 -1 0
vn 0 -1 0

# ---- UV（每面 4 个，左下 (0,0) 起逆时针）----
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# ---- 面（每面一个四边形）----
f 1/1/1 2/2/2 3/3/3 4/4/4
f 5/5/5 6/6/6 7/7/7 8/8/8
f 9/9/9 10/10/10 11/11/11 12/12/12
f 13/13/13 14/14/14 15/15/15 16/16/16
f 17/17/17 18/18/18 19/19/19 20/20/20
f 21/21/21 22/22/22 23/23/23 24/24/24
